# Editor local funciona sem credenciais. Preencha as integrações que quiser usar.
PORT=3001
# Caminho relativo à raiz do projeto ou caminho absoluto
# LOCAL_DATA_DIR=data
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# VITE_API_URL=http://localhost:3001
# MEDIA_BASE_URL=http://127.0.0.1:3001

# Anthropic — modelo econômico fixo Claude Haiku 5.5
ANTHROPIC_API_KEY=

# Shopee Afiliados — credenciais privadas, usadas somente no backend
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Instagram profissional — dados do app Meta
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v26.0
INSTAGRAM_USERNAME=
# Pode ficar vazio durante os testes locais
INSTAGRAM_PUBLIC_BASE_URL=

# Comentário LINK -> resposta pública e Direct
INSTAGRAM_APP_SECRET=
# Escolha um token próprio e use o mesmo na configuração do webhook na Meta
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_AUTOMATION_ENABLED=false

# Limpeza: arquivos de vídeos publicados há pelo menos 24 horas
MEDIA_CLEANUP_ENABLED=false
# Original só é removido quando todas as edições vinculadas já foram publicadas há 24h
MEDIA_CLEANUP_ORIGINALS=false
